{
  "name": "kidmidi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "npm run scores:check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "biome check .",
    "format": "biome check --write .",
    "scores:export": "tsx scripts/export-scores.ts",
    "scores:check": "tsx scripts/export-scores.ts --check",
    "smoke:pages": "node scripts/smoke-pages.mjs"
  },
  "dependencies": {
    "opensheetmusicdisplay": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vexflow": "1.2.93"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
