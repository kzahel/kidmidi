{
  "name": "kidmidi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "npm run scores:check && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "node scripts/styles.mjs && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "biome check . && npm run check:styles",
    "format": "biome check --write .",
    "scores:export": "tsx scripts/export-scores.ts",
    "scores:check": "tsx scripts/export-scores.ts --check",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "styles:write": "node scripts/styles.mjs --write",
    "check:styles": "node scripts/styles.mjs && stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "opensheetmusicdisplay": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vexflow": "1.2.93"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
